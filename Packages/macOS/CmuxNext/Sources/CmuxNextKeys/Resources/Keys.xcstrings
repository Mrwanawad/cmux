    "settingsVault.import.message": {
      "comment": "Settings > Cloud > Vault: the file panel's message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a .env file. Only its names are shown before you keep them."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ملف .env. تُعرض أسماؤه فقط قبل حفظها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite .env datoteku. Prije čuvanja prikazuju se samo njena imena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en .env-fil. Kun dens navne vises, før du gemmer dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine .env-Datei. Vor dem Speichern werden nur ihre Namen angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un archivo .env. Solo se muestran sus nombres antes de guardarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fichier .env. Seuls ses noms sont affichés avant de les garder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un file .env. Prima di salvarli vengono mostrati solo i nomi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".env ファイルを選んでください。保管する前は名前だけが表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជ្រើសរើសឯកសារ .env។ មានតែឈ្មោះរបស់វាប៉ុណ្ណោះដែលត្រូវបានបង្ហាញ មុនពេលអ្នករក្សាទុកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ".env 파일을 선택하세요. 보관하기 전에는 이름만 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en .env-fil. Bare navnene vises før du lagrer dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz plik .env. Przed zapisaniem widoczne są tylko jego nazwy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um arquivo .env. Somente os nomes são mostrados antes de você guardá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите файл .env. До сохранения показываются только имена."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกไฟล์ .env จะแสดงเฉพาะชื่อก่อนที่คุณจะเก็บ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir .env dosyası seçin. Saklamadan önce yalnızca adlar gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть файл .env. До збереження показуються лише імена."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn tệp .env. Chỉ các tên được hiển thị trước khi bạn lưu chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 .env 文件。保存前只会显示名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 .env 檔案。保存前只會顯示名稱。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
